{
  "name": "carousel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Brand-locked carousel and clip maker for Main Stage Studio clients. Ships as a Mac app per brand pack.",
  "author": "Main Stage Studio",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "studioBrand": "puremed",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest=./selftest-out",
    "build:mac": "electron-builder --mac",
    "icon": "node scripts/make-icon.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "uk.co.mainstagestudio.puremed-studio",
    "productName": "PureMed Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "brands/**",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "PureMed Studio",
      "artifactName": "PureMed-Studio-${version}-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osmanakhtar/main-stage-studio.git",
    "directory": "01_mss/tools/carousel-studio"
  }
}
