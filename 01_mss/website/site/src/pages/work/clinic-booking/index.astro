---
import { Image } from 'astro:assets';
import '../../../styles/global.css';

// Case study 3 of 3, split out from the single combined "Booking Engine"
// piece per Osman, 17 Aug 2026. Borrows Vera's own palette and type from the
// prototype (navy, gold, Fraunces/Hanken Grotesk) and its gallery layout
// instinct: low density, generous whitespace, the tenant "allowed to
// breathe." Multi-tenancy is mentioned once, near the end, as a capacity
// note rather than the claim.

import veraHero from '../../../assets/intake-vera-hero.jpg';

const built = [
  {
    t: 'A consultation before a treatment can be booked',
    d: 'RULE-004 reroutes a client with no consultation on record: selecting a wrinkle-softening treatment sends them to a Consultation and Treatment Plan instead, with the reason on the page. It is not a nicety, it is the mechanism a clinic uses to evidence its own prescribing policy.',
  },
  {
    t: 'Signature capture that actually stands up',
    d: 'A drawn or typed signature, per-clause acknowledgement with its own timestamp, and a SHA-256 hash computed over the rendered document, viewable and independently verifiable. That set is what makes the record evidential, not the image of a mark.',
  },
  {
    t: 'Photography consent, kept structurally separate',
    d: 'Consent to treatment and consent to marketing use of before-and-after images are two different signatures, because consent to treatment is not freely given if refusing means not being treated. Bundling them is the single most common compliance failure in aesthetics marketing.',
  },
  {
    t: 'A medicine that is never named to the public',
    d: 'RULE-002 here: prescription-only medicines cannot be advertised, so the catalogue carries a public-facing name and the medicine itself is never named on the site, in the journey, or in the confirmation.',
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clinic booking &amp; consent, a case study | Main Stage Studio</title>
  <meta name="description" content="A booking and consent system built for a regulated aesthetics clinic: evidential signature capture, and a rule that reroutes a client with no consultation on record.">
  <meta property="og:title" content="Clinic booking &amp; consent, a case study | Main Stage Studio">
  <meta property="og:description" content="Watch a nurse-prescriber-led clinic take on a new client end to end: consulted, screened, consented and booked, in one sitting.">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Hanken+Grotesk:wght@300;400;500;600&display=swap" rel="stylesheet">

  <script is:inline>document.documentElement.classList.add('js-anim');</script>

  <style>
    :root {
      --nav-height: 64px;
      --bone: #F5F2EC;
      --navy: #1E2B4D;
      --navy-soft: #E7EAF1;
      --gold: #C6A667;
      --ink:  #141A2B;
      --ink-muted: #6E7382;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { background: var(--bone); scroll-behavior: smooth; }
    body {
      font-family: 'Hanken Grotesk', system-ui, sans-serif;
      font-weight: 300;
      background: var(--bone);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      padding-top: var(--nav-height);
    }

    .wrap { max-width: 1120px; margin-inline: auto; }
    .measure { max-width: 62ch; }

    .display {
      font-family: 'Fraunces', Georgia, serif;
      font-optical-sizing: auto;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1.12;
      text-wrap: balance;
    }
    .display em { font-style: italic; color: var(--gold); }

    .eyebrow { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
    .body-copy { font-weight: 300; font-size: 1.0625rem; line-height: 1.8; color: var(--ink-muted); }
    .rule { width: 56px; height: 1px; background: var(--gold); border: none; opacity: .9; }
    .meta-key { font-size: 0.5625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }

    .built-row { display: grid; grid-template-columns: 3rem 1fr; gap: 1.5rem; padding: 2.25rem 0; border-top: 1px solid rgba(20,26,43,0.08); }
    .built-row:last-child { border-bottom: 1px solid rgba(20,26,43,0.08); }
    .built-num { font-family: 'Fraunces', Georgia, serif; font-size: 1.5rem; color: var(--gold); line-height: 1; font-variant-numeric: tabular-nums; }

    .shot { border: 1px solid rgba(20,26,43,0.1); overflow: hidden; display: block; }
    .shot img { display: block; width: 100%; height: auto; }
    .shot-cap { margin-top: 0.75rem; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }

    .cta {
      position: relative; display: inline-flex; align-items: center; gap: 0.6rem;
      overflow: hidden; background: var(--navy); color: var(--bone);
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; padding: 1rem 2.25rem; will-change: transform;
    }
    .cta__bg { position: absolute; inset: 0; background: var(--gold); transform: translateX(-101%); transition: transform 0.45s cubic-bezier(0.16,1,0.3,1); pointer-events: none; }
    .cta:hover .cta__bg { transform: translate(0,0); }
    .cta:hover .cta__label { color: var(--ink); }
    .cta__label { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 0.6rem; transition: color .3s; }
    .cta:active { transform: translateY(1px) scale(0.98); }

    .cta-ghost {
      display: inline-flex; align-items: center; gap: 0.6rem; color: var(--navy);
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; border-bottom: 1px solid rgba(30,43,77,0.3); padding-bottom: 2px;
      transition: border-color 0.25s ease;
    }
    .cta-ghost:hover { border-color: var(--navy); }

    :focus-visible { outline: 2px solid var(--navy); outline-offset: 3px; }
    .oncolour :focus-visible { outline-color: var(--gold); }

    .skip-link { position: absolute; left: 1rem; top: -100px; z-index: 50; background: var(--ink); color: var(--bone); font-size: 0.8125rem; padding: 0.75rem 1.25rem; text-decoration: none; transition: top 0.2s ease; }
    .skip-link:focus { top: 1rem; }

    .reveal { opacity: 1; }
    .js-anim .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1); }
    .js-anim .reveal.in-view { opacity: 1; transform: translateY(0); }

    #nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: var(--nav-height); background: var(--bone); border-bottom: 1px solid rgba(198,166,103,0.4); display: flex; align-items: center; }
    #nav > .wrap { width: 100%; display: flex; align-items: center; justify-content: space-between; }
    .backbar { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--ink-muted); font-size: 0.75rem; letter-spacing: 0.04em; transition: color 0.25s ease, gap 0.25s ease; }
    .backbar:hover { color: var(--ink); gap: 0.95rem; }
    .nav-meta { font-size: 10px; font-weight: 400; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-muted); }

    #scroll-progress { position: fixed; top: 0; left: 0; width: 2px; height: 0%; background: var(--gold); z-index: 60; will-change: height; transition: height 60ms linear; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; transition-delay: 0ms !important; }
      .js-anim .reveal { opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>

<body>

  <a href="#main" class="skip-link">Skip to content</a>
  <div id="scroll-progress" aria-hidden="true"></div>

  <nav id="nav">
    <div class="wrap px-6 md:px-10">
      <a href="/#work" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <span class="nav-meta">Case study &middot; Aesthetics clinic</span>
    </div>
  </nav>

  <main id="main">

    <!-- ── Hero ────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-16 md:pt-28 pb-20">
      <p class="eyebrow mb-6">Systems &middot; Aesthetics clinic</p>
      <h1 class="display mb-10" style="font-size:clamp(2.75rem,7.5vw,5.75rem);max-width:18ch;">
        Consent that can <em>stand up</em> in a file review.
      </h1>
      <hr class="rule mb-8">
      <p class="body-copy measure" style="font-size:1.1875rem;">
        A booking and consent system built for a regulated clinic, not a generic scheduler with a form bolted on. Signature capture that is genuinely evidential, a screening step that can decline or reroute a booking on clinical grounds, and a rule that will not let a client book a prescription treatment without a consultation on record.
      </p>

      <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-14 pt-8" style="border-top:1px solid rgba(20,26,43,0.1);">
        <div>
          <dt class="meta-key mb-2">Sector</dt>
          <dd class="text-sm font-light">Medical aesthetics</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Scope</dt>
          <dd class="text-sm font-light">Journey architecture &middot; Rules design &middot; Prototype</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Regulator</dt>
          <dd class="text-sm font-light">Professional body, CQC (partial)</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Status</dt>
          <dd class="text-sm font-light">Working prototype, open to try</dd>
        </div>
      </dl>
    </section>

    <!-- ── The shot ────────────────────────────────────────────── -->
    <section class="pb-24 md:pb-32 reveal">
      <div class="wrap px-6 md:px-10">
        <div class="shot">
          <Image src={veraHero} alt="Vera Aesthetics: the clinic's own site, opening on the consultation-first treatment list"
                 widths={[560, 900, 1800]} sizes="100vw" format="webp" quality={78} loading="lazy" decoding="async" />
        </div>
        <p class="text-xs font-light mt-4" style="color:var(--ink-muted);max-width:72ch;line-height:1.7;">
          Vera Aesthetics' own site, captured live from the running prototype. Consultation sits first in the list deliberately: "your face is not a menu." Nothing here is a mock-up, the rules fire against the actual selections a visitor makes.
        </p>
      </div>
    </section>

    <!-- ── The challenge ───────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">The challenge</p>
          <p class="display" style="font-size:clamp(3.5rem,8vw,6rem);line-height:0.9;color:var(--navy);">9</p>
          <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
            Article 9, the UK GDPR category health data falls under.
          </p>
        </div>
        <div class="reveal flex flex-col gap-6">
          <h2 class="display mb-2" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:22ch;">
            Aesthetics intake carries special category data and prescription-only medicines.
          </h2>
          <p class="body-copy">
            Health data, informed consent that has to be evidential rather than decorative, and medicines that legally cannot be named to the public. A generic scheduler with a PDF consent form bolted on does not touch any of that, and a black-box aesthetics platform hides how it was handled.
          </p>
          <p class="body-copy">
            The clinic needs to be able to open the record for any booking and show exactly what was asked, what was signed, and when.
          </p>
        </div>
      </div>
    </section>

    <!-- ── The insight ─────────────────────────────────────────── -->
    <section class="oncolour" style="background:var(--navy);">
      <div class="wrap px-6 md:px-10 py-24 md:py-32 reveal">
        <hr class="rule mb-6">
        <p class="eyebrow mb-8">The insight</p>
        <h2 class="display" style="font-size:clamp(1.875rem,4vw,3.25rem);color:var(--bone);max-width:30ch;">
          A signature only proves what it was captured next to. Build the evidence, and the signature stops being the weak point.
        </h2>
      </div>
    </section>

    <!-- ── What was built ──────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-24 md:py-32">
      <div class="mb-14 reveal">
        <p class="eyebrow mb-5">What was built</p>
        <h2 class="display" style="font-size:clamp(2rem,4vw,3rem);max-width:22ch;">
          Four decisions that carry the clinical weight.
        </h2>
      </div>
      <div class="reveal">
        {built.map((item, i) => (
          <div class="built-row">
            <span class="built-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="display mb-3" style="font-size:1.5rem;">{item.t}</h3>
              <p class="body-copy" style="font-size:1rem;max-width:64ch;">{item.d}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── What it's worth ─────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pb-24 md:pb-32">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">What it's worth</p>
          <p class="display" style="font-size:clamp(3rem,7vw,5rem);line-height:0.95;color:var(--navy);">&pound;58k</p>
          <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
            Modelled annual value, recovered no-shows and reclaimed admin time. Not a client result.
          </p>
        </div>
        <div class="reveal flex flex-col gap-6">
          <p class="body-copy">
            A single-practitioner clinic of this size runs roughly 400 bookings a year through a mix of phone, WhatsApp and a third-party scheduler, with a typical 12% no-show rate on treatments averaging &pound;180. A deposit taken and a document actually signed at the point of booking, rather than chased afterwards, is conservatively worth halving that no-show rate.
          </p>
          <p class="body-copy">
            That's roughly &pound;17,000 a year recovered directly, plus an estimated 5 hours a week of admin time no longer spent chasing forms and re-sending links, valued at &pound;25/hour across a working year: another &pound;41,000. Together, &pound;58,000.
          </p>
          <div class="mt-2 pt-6" style="border-top:1px solid rgba(20,26,43,0.1);">
            <p class="text-xs font-light" style="color:var(--ink-muted);line-height:1.7;max-width:64ch;">
              <b style="color:var(--ink);font-weight:600;">Modelled, not measured.</b> 400 bookings/year, a 12% baseline no-show rate and &pound;180 average treatment value are illustrative figures for a clinic of this size; the reduction and the admin-time estimate are conservative assumptions, not a measured result from a live clinic. Change any input and the number changes with it, the mechanism is what's real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Where it stands ─────────────────────────────────────── -->
    <section style="background:var(--navy-soft);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
          <div class="reveal">
            <p class="eyebrow mb-5">Where it stands</p>
            <h2 class="display" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:16ch;">
              A working prototype, not a pitch deck.
            </h2>
          </div>
          <div class="reveal flex flex-col gap-6">
            <p class="body-copy">
              Open to try, built to be taken apart rather than only looked at. Nothing here is mocked up: the rules fire for real, the slot holds for real, the signature hashes for real.
            </p>
            <p class="body-copy">
              The same architecture also runs a firm of solicitors and a chartered accountancy practice, each configured on its own record, its own rules and its own vocabulary, and it scales the same way to a clinic with more than one practitioner or site. Wiring it to a real calendar, a real payment provider and a real patient record is integration work, not redesign.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── CTA ─────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-24 md:py-32">
      <div class="reveal">
        <h2 class="display mb-6" style="font-size:clamp(1.875rem,4vw,3rem);max-width:22ch;">
          Booking on WhatsApp and hoping the form gets sent back?
        </h2>
        <p class="body-copy measure mb-10">
          That's the gap this closes, dropped into the site you already have. Tell us about your clinic, and we'll show you what it looks like running on your own booking flow.
        </p>
        <div class="flex flex-wrap items-center gap-8">
          <a href="/#contact" class="cta">
            <span class="cta__bg"></span>
            <span class="cta__label">Start a project</span>
          </a>
          <a href="/work/booking-engine/prototype/?tenant=vera" class="cta-ghost">
            Open the prototype yourself
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M1 6.5h11M7.5 1.5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="wrap px-6 md:px-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-10" style="border-top:1px solid rgba(20,26,43,0.1);">
      <a href="/" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <p class="text-xs font-light" style="color:var(--ink-muted);">
        Clinic booking &amp; consent case study. Self-initiated. Published by Main Stage Studio.
      </p>
    </div>
  </footer>

  <script>
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.height = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }, { passive: true });
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>

</body>
</html>
