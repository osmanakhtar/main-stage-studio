---
import { Image } from 'astro:assets';
import '../../../styles/global.css';

// Case study 2 of 3, split out from the single combined "Booking Engine"
// piece per Osman, 17 Aug 2026 (that page previously lived at
// /work/booking-engine/). Borrows Marbury Hale's own palette and type from
// the prototype (deep green, brass, Source Serif 4/Inter) and its ledger
// layout instinct: no photography, no card containers, figures ruled and
// right-aligned. Multi-tenancy is mentioned once, near the end, as a
// capacity note rather than the claim.

import marburyHero from '../../../assets/intake-marbury-hero.jpg';

const built = [
  {
    t: 'One sitting, not five handoffs',
    d: 'Book a slot, pass risk screening, read and sign the engagement letter, and authorise the deposit, all in the same visit. Every one of those used to be its own phone call or email thread, and every extra one is a chance for the prospect to not get round to it.',
  },
  {
    t: 'The regulated-advice boundary, enforced automatically',
    d: 'The practice is not authorised to give investment, pension or insurance advice, so every advisory engagement carries a scope statement that cannot be removed at proposal stage. Switch it off in admin and the trace says plainly what that exposes the firm to.',
  },
  {
    t: 'Every requirement traces to a numbered rule',
    d: 'The panel a practice sees beside the journey is not a debug view. It is the compliance artefact: each question the client was asked, and the rule that required it, with a version and a value. Ask what asked for this, and the answer is right there instead of in someone’s head.',
  },
  {
    t: 'The record commits the moment the client does',
    d: 'A signed document is hashed, timestamped and written to the practice’s record at the same instant the client sees their own confirmation. Nothing waits for a person to file it later, and nothing is real until both sides have it.',
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Accountancy client intake, a case study | Main Stage Studio</title>
  <meta name="description" content="A client intake system built for accountancy: the regulated-advice boundary is enforced automatically, so no engagement goes out without the scope statement the practice is required to carry.">
  <meta property="og:title" content="Accountancy client intake, a case study | Main Stage Studio">
  <meta property="og:description" content="Watch a chartered accountancy practice take on a new client end to end: booked, risk-screened, signed and paid, in one sitting.">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <script is:inline>document.documentElement.classList.add('js-anim');</script>

  <style>
    :root {
      --nav-height: 64px;
      --bone:  #F6F4EF;
      --green: #1B3A32;
      --green-hover: #255045;
      --brass: #A8853F;
      --ink:   #16211E;
      --ink-muted: #6B7370;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { background: var(--bone); scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      font-weight: 300;
      background: var(--bone);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      padding-top: var(--nav-height);
    }

    .wrap { max-width: 1120px; margin-inline: auto; }
    .measure { max-width: 62ch; }

    .display { font-family: 'Source Serif 4', Georgia, serif; font-weight: 400; letter-spacing: -0.01em; line-height: 1.12; text-wrap: balance; }
    .display em { font-style: italic; color: var(--brass); }
    .num { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }

    .eyebrow { font-size: 0.625rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brass); }
    .body-copy { font-weight: 300; font-size: 1.0625rem; line-height: 1.75; color: var(--ink-muted); }
    .rule { width: 56px; height: 1px; background: var(--brass); border: none; opacity: .85; }
    .meta-key { font-size: 0.5625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-muted); }

    .built-row { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.5rem; padding: 1.75rem 0; border-top: 1px solid rgba(22,33,30,0.14); align-items: baseline; }
    .built-row:last-child { border-bottom: 1px solid rgba(22,33,30,0.14); }
    .built-num { font-family: 'JetBrains Mono', monospace; font-size: 0.9375rem; color: var(--brass); font-variant-numeric: tabular-nums; text-align: right; }

    .shot { border: 1px solid rgba(22,33,30,0.16); background: var(--ink); overflow: hidden; display: block; }
    .shot img { display: block; width: 100%; height: auto; }
    .shot-cap { margin-top: 0.75rem; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }

    .clip-frame { position: relative; background: var(--ink); border: 1px solid rgba(22,33,30,0.16); aspect-ratio: 16 / 9; overflow: hidden; }
    .clip-video { display: block; width: 100%; height: 100%; object-fit: cover; }
    .clip-play { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-start; width: 100%; height: 100%; padding: 1.25rem; background: transparent; border: none; cursor: pointer; transition: background 0.3s ease; }
    .clip-play:hover { background: rgba(22,33,30,0.22); }
    .clip-frame.is-playing .clip-play { display: none; }
    .clip-play span { display: inline-flex; align-items: center; gap: 0.625rem; padding: 0.6rem 1.1rem 0.6rem 0.95rem; background: var(--bone); color: var(--ink); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; box-shadow: 0 4px 20px rgba(0,0,0,0.35); transition: transform 0.3s cubic-bezier(0.16,1,0.3,1); }
    .clip-play:hover span { transform: translateY(-2px); }

    .cta {
      position: relative; display: inline-flex; align-items: center; gap: 0.6rem;
      overflow: hidden; background: var(--ink); color: var(--bone);
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; padding: 1rem 2.25rem; will-change: transform;
    }
    .cta__bg { position: absolute; inset: 0; background: var(--green); transform: translateX(-101%); transition: transform 0.45s cubic-bezier(0.16,1,0.3,1); pointer-events: none; }
    .cta:hover .cta__bg { transform: translate(0,0); }
    .cta__label { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 0.6rem; }
    .cta:active { transform: translateY(1px) scale(0.98); }

    .cta-ghost {
      display: inline-flex; align-items: center; gap: 0.6rem; color: var(--green);
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; border-bottom: 1px solid rgba(27,58,50,0.35); padding-bottom: 2px;
      transition: border-color 0.25s ease;
    }
    .cta-ghost:hover { border-color: var(--green); }

    :focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
    .oncolour :focus-visible { outline-color: var(--brass); }

    .skip-link { position: absolute; left: 1rem; top: -100px; z-index: 50; background: var(--ink); color: var(--bone); font-size: 0.8125rem; padding: 0.75rem 1.25rem; text-decoration: none; transition: top 0.2s ease; }
    .skip-link:focus { top: 1rem; }

    .reveal { opacity: 1; }
    .js-anim .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1); }
    .js-anim .reveal.in-view { opacity: 1; transform: translateY(0); }

    #nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: var(--nav-height); background: var(--bone); border-bottom: 1px solid rgba(168,133,63,0.4); display: flex; align-items: center; }
    #nav > .wrap { width: 100%; display: flex; align-items: center; justify-content: space-between; }
    .backbar { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--ink-muted); font-size: 0.75rem; letter-spacing: 0.04em; transition: color 0.25s ease, gap 0.25s ease; }
    .backbar:hover { color: var(--ink); gap: 0.95rem; }
    .nav-meta { font-size: 10px; font-weight: 400; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-muted); }

    #scroll-progress { position: fixed; top: 0; left: 0; width: 2px; height: 0%; background: var(--brass); z-index: 60; will-change: height; transition: height 60ms linear; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; transition-delay: 0ms !important; }
      .js-anim .reveal { opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>

<body>

  <a href="#main" class="skip-link">Skip to content</a>
  <div id="scroll-progress" aria-hidden="true"></div>

  <nav id="nav">
    <div class="wrap px-6 md:px-10">
      <a href="/#work" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <span class="nav-meta">Case study &middot; Accountancy</span>
    </div>
  </nav>

  <main id="main">

    <!-- ── Hero ────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-16 md:pt-24 pb-16">
      <p class="eyebrow mb-6">Systems &middot; Accountancy</p>
      <h1 class="display mb-8" style="font-size:clamp(2.75rem,7vw,5.5rem);max-width:17ch;">
        Booked, signed and paid, before they change their mind.
      </h1>
      <hr class="rule mb-8">
      <p class="body-copy measure" style="font-size:1.1875rem;">
        A client intake system built for chartered accountancy, where becoming a client happens in one sitting rather than across five separate handoffs, and the regulated-advice boundary the practice is required to carry cannot quietly go missing from a proposal.
      </p>

      <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-14 pt-8" style="border-top:1px solid rgba(22,33,30,0.16);">
        <div>
          <dt class="meta-key mb-2">Sector</dt>
          <dd class="text-sm font-light">Chartered accountancy</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Scope</dt>
          <dd class="text-sm font-light">Journey architecture &middot; Rules design &middot; Prototype</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Regulator</dt>
          <dd class="text-sm font-light">AML supervision, per-body scope rules</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Status</dt>
          <dd class="text-sm font-light">Working prototype, open to try</dd>
        </div>
      </dl>
    </section>

    <!-- ── The demo ────────────────────────────────────────────── -->
    <section class="pt-4 pb-20 md:pb-28 reveal">
      <div class="wrap px-6 md:px-10">
        <div class="clip-frame">
          <video class="clip-video"
                 src="/assets/intake-onboarding.mp4"
                 poster="/assets/intake-onboarding.webp"
                 preload="none"
                 muted
                 loop
                 playsinline
                 width="1280"
                 height="720"
                 aria-label="A full onboarding run at Marbury Hale, chartered accountants: service selection, booking, risk screening, signing and payment"></video>
          <button type="button" class="clip-play" aria-label="Play recording: the full onboarding run">
            <span>
              <svg width="11" height="13" viewBox="0 0 11 13" aria-hidden="true">
                <path d="M11 6.5 0 13V0z" fill="#16211E"/>
              </svg>
              Play the full run
            </span>
          </button>
        </div>
        <p class="text-xs font-light mt-4" style="color:var(--ink-muted);max-width:72ch;line-height:1.7;">
          Recorded against the live prototype, switched to the Marbury Hale tenant. Nothing is staged: the rules engine on the right is firing against the actual selections made in the run, the signature is drawn live, and the confirmation reference is real for this take.
        </p>
      </div>
    </section>

    <!-- ── The challenge ───────────────────────────────────────── -->
    <section style="background:var(--green);" class="oncolour">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
          <div class="reveal">
            <p class="eyebrow mb-5">The challenge</p>
            <p class="display num" style="font-size:clamp(3.5rem,8vw,6rem);line-height:0.9;color:var(--brass);">5</p>
            <p class="text-sm font-light mt-4" style="color:rgba(246,244,239,.75);max-width:24ch;">
              Handoffs before a new enquiry becomes a signed client.
            </p>
          </div>
          <div class="reveal flex flex-col gap-6">
            <h2 class="display mb-2" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:22ch;color:var(--bone);">
              A regulated practice doesn't lose a client to bad design.
            </h2>
            <p class="body-copy" style="color:rgba(246,244,239,.75);">
              It loses them between the enquiry and the engagement: a call to book, an email with the letter of engagement, a chase for the signature, a separate call for the deposit. Every extra step is a chance for someone with three other quotes open to not get back to it.
            </p>
            <p class="body-copy" style="color:rgba(246,244,239,.75);">
              None of that is a design problem. A nicer enquiry form does not remove a single handoff, and it does nothing about the scope statement a practice is required to carry on every advisory engagement.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── The insight ─────────────────────────────────────────── -->
    <section class="oncolour" style="background:var(--ink);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28 reveal">
        <hr class="rule mb-6">
        <p class="eyebrow mb-8">The insight</p>
        <h2 class="display" style="font-size:clamp(1.875rem,4vw,3.25rem);color:var(--bone);max-width:32ch;">
          Conversion, for a regulated practice, is not a landing page problem. It is every extra step between interested and signed, so the fix is removing the steps, not decorating them.
        </h2>
      </div>
    </section>

    <!-- ── What was built ──────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="mb-12 reveal">
        <p class="eyebrow mb-5">What was built</p>
        <h2 class="display" style="font-size:clamp(2rem,4vw,3rem);max-width:20ch;">
          Four decisions that set everything else.
        </h2>
      </div>
      <div class="reveal">
        {built.map((item, i) => (
          <div class="built-row">
            <span class="built-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="display mb-3" style="font-size:1.5rem;">{item.t}</h3>
              <p class="body-copy" style="font-size:1rem;max-width:64ch;">{item.d}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── What shipped ────────────────────────────────────────── -->
    <section style="background:#EFEBE1;">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="mb-12 reveal">
          <p class="eyebrow mb-5">What shipped</p>
          <h2 class="display" style="font-size:clamp(2rem,4vw,3rem);max-width:22ch;">
            The practice's own site, and the ledger running behind it.
          </h2>
          <p class="body-copy measure mt-6">
            Marbury Hale's site carries its own key dates and fee schedule: dense and ruled, the way a firm of accountants actually reads. No photography, no card containers, a recolour is not a redesign.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 md:gap-8">
          <figure class="reveal">
            <div class="shot">
              <Image src={marburyHero} alt="The Marbury Hale site: chartered accountants, a key-dates panel for the tax year, and the onboarding entry point"
                     widths={[560, 900, 1800]} sizes="100vw" format="webp" quality={78} loading="lazy" decoding="async" />
            </div>
            <figcaption class="shot-cap">Marbury Hale, the tenant site</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ── What it's worth ─────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-20 md:pt-28 pb-8 md:pb-10">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">What it's worth</p>
          <p class="display num" style="font-size:clamp(3rem,7vw,5rem);line-height:0.95;color:var(--green);">&pound;146k</p>
          <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
            Modelled annual revenue, closing the intake gap for one practice of this size. Not a client result.
          </p>
        </div>
        <div class="reveal flex flex-col gap-6">
          <p class="body-copy">
            A practice of this size runs roughly 30 qualified new-client enquiries a month, 360 a year, split across compliance-only, advisory and one-off work, and converts around 4 in 10 into an engaged client under a multi-week, multi-touch onboarding process. Closing the gap to one sitting is worth, conservatively, a 20% relative lift: from 40% to 48%.
          </p>
          <p class="body-copy">
            That's roughly 29 more engaged clients a year. At an average first-year fee of &pound;1,750 across the mix of compliance and advisory work, that's roughly &pound;146,000 in additional annual revenue, from the same enquiries the practice was already paying to generate.
          </p>
          <div class="mt-2 pt-6" style="border-top:1px solid rgba(22,33,30,0.16);">
            <p class="text-xs font-light" style="color:var(--ink-muted);line-height:1.7;max-width:64ch;">
              <b style="color:var(--ink);font-weight:600;">Modelled, not measured.</b> 30 enquiries/month, 40% baseline conversion and &pound;1,750 average first-year fee are illustrative figures for a practice of this size; the 20% uplift is a conservative estimate for removing weeks of back-and-forth from onboarding, not a measured A/B result. Change any input and the number changes with it, the mechanism is what's real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Where it stands ─────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-20 md:pt-28 pb-8 md:pb-10">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">Where it stands</p>
          <h2 class="display" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:16ch;">
            A working prototype, not a pitch deck.
          </h2>
        </div>
        <div class="reveal flex flex-col gap-6">
          <p class="body-copy">
            Open to try, built to be taken apart rather than only looked at. Nothing here is mocked up: the rules fire for real, the slot holds for real, the signature hashes for real.
          </p>
          <p class="body-copy">
            The same architecture also runs a firm of solicitors and a regulated aesthetics clinic, each configured on its own record, its own rules and its own vocabulary, and it scales the same way to a practice with several partners or offices. Wiring it to a real calendar, a real payment provider and a real client record is integration work, not redesign.
          </p>
        </div>
      </div>
    </section>

    <!-- ── CTA ─────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="reveal">
        <h2 class="display mb-6" style="font-size:clamp(1.875rem,4vw,3rem);max-width:22ch;">
          Losing prospects somewhere between interested and signed?
        </h2>
        <p class="body-copy measure mb-10">
          That's the gap this closes, dropped into the site you already have. Tell us about your practice, and we'll show you what it looks like running on your own intake.
        </p>
        <div class="flex flex-wrap items-center gap-8">
          <a href="/#contact" class="cta">
            <span class="cta__bg"></span>
            <span class="cta__label">Start a project</span>
          </a>
          <a href="/work/booking-engine/prototype/?tenant=marbury" class="cta-ghost">
            Open the prototype yourself
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M1 6.5h11M7.5 1.5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="wrap px-6 md:px-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-10" style="border-top:1px solid rgba(22,33,30,0.16);">
      <a href="/" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <p class="text-xs font-light" style="color:var(--ink-muted);">
        Accountancy client intake case study. Self-initiated. Published by Main Stage Studio.
      </p>
    </div>
  </footer>

  <script>
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.height = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }, { passive: true });
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    document.querySelectorAll('.clip-frame').forEach(frame => {
      const video = frame.querySelector('video');
      const button = frame.querySelector('.clip-play');
      if (!video || !button) return;

      button.addEventListener('click', () => {
        frame.classList.add('is-playing');
        video.controls = true;
        video.play();
        video.focus();
      });

      const vis = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting && !video.paused) video.pause();
        });
      }, { threshold: 0.25 });
      vis.observe(frame);
    });
  </script>

</body>
</html>
