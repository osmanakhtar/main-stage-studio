  <script>
    // ── Scroll progress ───────────────────────────────────────────
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.height = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }, { passive: true });
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Tooling clips: click-to-play, then hand over to native controls so the
    // clip can be scrubbed and paused. Nothing downloads until the first press
    // (preload="none"), which is the point of the poster.
    document.querySelectorAll('.clip-frame').forEach(frame => {
      const video = frame.querySelector('video');
      const button = frame.querySelector('.clip-play');
      if (!video || !button) return;

      button.addEventListener('click', () => {
        frame.classList.add('is-playing');
        video.controls = true;
        video.play();
        video.focus();
      });

      // Pause whatever is playing once it scrolls out of view, so two clips
      // are never running at once behind the reader's back.
      const vis = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting && !video.paused) video.pause();
        });
      }, { threshold: 0.25 });
      vis.observe(frame);
    });
  </script>

