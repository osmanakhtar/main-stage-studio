---
import { Image } from 'astro:assets';
import '../../../styles/global.css';

// This is the one case study on the site that is not written in a client's
// world, because there isn't a client: Intake is Main Stage Studio's own
// systems piece, self-initiated to prove the Systems half of the offer
// rather than assert it. So the design voice here is the studio's own —
// parchment, terracotta, near-black — the same tokens as the rest of the
// site, not a borrowed brand.

// Captured 9 Aug 2026 from the live prototype at /work/booking-engine/prototype/,
// switched to the Marbury Hale (accountancy) tenant. The dashboard shot is
// the practice's own site with its key-dates panel; the rule-trace shot is
// the compliance ledger mid-journey, showing the AML and engagement rules
// that fired before a booking slot was even offered.
import marburyHero from '../../../assets/intake-marbury-hero.jpg';
import ruleTraceDetail from '../../../assets/intake-rule-trace-detail.png';

const built = [
  {
    t: 'One sitting, not five handoffs',
    d: 'Book a slot, pass risk screening, read and sign the engagement letter, and authorise the deposit, all in the same visit. Every one of those used to be its own phone call or email thread, and every extra one is a chance for the prospect to not get round to it.',
  },
  {
    t: 'Every requirement traces to a numbered rule',
    d: 'The panel a practice sees beside the journey is not a debug view. It is the compliance artefact: each question the client was asked, and the rule that required it, with a version and a value. Ask what asked for this, and the answer is right there instead of in someone’s head.',
  },
  {
    t: 'The slot is held the moment it is chosen',
    d: 'Ten minutes, leased, with nobody else able to take it while you fill in the rest. A booking that can vanish underneath a prospect while they type is a booking that teaches them not to bother next time.',
  },
  {
    t: 'The record commits the moment the client does',
    d: 'A signed document is hashed, timestamped and written to the practice’s record at the same instant the client sees their own confirmation. Nothing waits for a person to file it later, and nothing is real until both sides have it.',
  },
  {
    t: 'Same engine, different practice entirely',
    d: 'A solicitor, a chartered accountant and an aesthetics clinic run on the identical code, differing only in the tenant record: their rules, their documents, their vocabulary, their look. A recolour is not a redesign, which is the point.',
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Booking Engine, a case study | Main Stage Studio</title>
  <meta name="description" content="A regulated practice doesn't lose a client to bad design. It loses them to the gap between interested and signed. Booking Engine closes that gap in one sitting: booked, screened, signed and paid.">
  <meta property="og:title" content="Booking Engine, a case study | Main Stage Studio">
  <meta property="og:description" content="Watch a chartered accountancy practice take on a new client end to end: booked, risk-screened, signed and paid, in one sitting.">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-400-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-300-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/plus-jakarta-sans-400-latin.woff2" crossorigin>

  <script is:inline>document.documentElement.classList.add('js-anim');</script>

  <style>
    :root {
      --nav-height: 64px;

      --parchment:  #F5EFE5;
      --blush:      #E8C9AE;
      --terracotta: #BF6B47;
      --terracotta-hover: #A85B3B;
      --ember:      #8C4A2F;
      --near-black: #1C1712;
      --ink-muted:  #6B6459;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { background: var(--parchment); scroll-behavior: smooth; }
    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: var(--parchment);
      color: var(--near-black);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      padding-top: var(--nav-height);
    }

    .wrap { max-width: 1120px; margin-inline: auto; }
    .measure { max-width: 62ch; }

    .display {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-weight: 400;
      letter-spacing: -0.015em;
      line-height: 1.1;
      text-wrap: balance;
    }

    .eyebrow {
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--ember);
    }

    .body-copy {
      font-weight: 300;
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--ink-muted);
    }

    .rule-terracotta {
      width: 56px;
      height: 2px;
      background: var(--terracotta);
      border: none;
    }

    .meta-key {
      font-size: 0.5625rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .built-row {
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: 1.5rem;
      padding: 2rem 0;
      border-top: 1px solid rgba(28,23,18,0.10);
    }
    .built-row:last-child { border-bottom: 1px solid rgba(28,23,18,0.10); }
    .built-num {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 1.5rem;
      color: var(--ink-muted);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .shot {
      border: 1px solid rgba(28,23,18,0.10);
      background: var(--near-black);
      overflow: hidden;
      display: block;
    }
    .shot img { display: block; width: 100%; height: auto; }

    .shot-cap {
      margin-top: 0.75rem;
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    /* ── The demo clip ───────────────────────────────────────────
       Screen recording captured 9 Aug 2026, switched to the Marbury Hale
       tenant, running the real prototype end to end: service selection
       through to the signed, paid confirmation. Click to play rather than
       autoplay, same reasoning as every other clip on this site: a page
       arguing for a fast journey should not spend bandwidth on visitors
       who never press play. */
    .clip-frame {
      position: relative;
      background: var(--near-black);
      border: 1px solid rgba(28,23,18,0.10);
      aspect-ratio: 16 / 9;
      overflow: hidden;
    }
    .clip-video {
      display: block;
      width: 100%; height: 100%;
      object-fit: cover;
    }
    .clip-play {
      position: absolute; inset: 0;
      display: flex; align-items: flex-end; justify-content: flex-start;
      width: 100%; height: 100%;
      padding: 1.25rem;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: background 0.3s ease;
    }
    .clip-play:hover { background: rgba(28,23,18,0.18); }
    .clip-frame.is-playing .clip-play { display: none; }

    .clip-play span {
      display: inline-flex; align-items: center; gap: 0.625rem;
      padding: 0.6rem 1.1rem 0.6rem 0.95rem;
      background: var(--parchment);
      color: var(--near-black);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      box-shadow: 0 4px 20px rgba(28,23,18,0.35);
      transition: transform 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    .clip-play:hover span { transform: translateY(-2px); }

    .cta {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--near-black);
      color: var(--parchment);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 1rem 2.25rem;
      transition: background 0.25s ease;
    }
    .cta:hover { background: var(--ember); }
    .cta:active { transform: translateY(1px); }

    .cta-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--ember);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      border-bottom: 1px solid rgba(140,74,47,0.35);
      padding-bottom: 2px;
      transition: border-color 0.25s ease;
    }
    .cta-ghost:hover { border-color: var(--ember); }

    :focus-visible { outline: 2px solid var(--ember); outline-offset: 3px; }
    .oncolour :focus-visible { outline-color: var(--blush); }

    .skip-link {
      position: absolute; left: 1rem; top: -100px; z-index: 50;
      background: var(--near-black); color: var(--parchment);
      font-size: 0.8125rem; padding: 0.75rem 1.25rem; text-decoration: none;
      transition: top 0.2s ease;
    }
    .skip-link:focus { top: 1rem; }

    .reveal { opacity: 1; }
    .js-anim .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1),
                  transform 0.8s cubic-bezier(0.16,1,0.3,1);
    }
    .js-anim .reveal.in-view { opacity: 1; transform: translateY(0); }

    /* ── Nav ────────────────────────────────────────────────────
       Geometry, position and behaviour fixed across the portfolio, per the
       case study checklist. Colours are the studio's own here, since this
       is a self-initiated piece rather than a client's world. Label reads
       "Case study" for that reason, matching Sable. */
    #nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 50;
      height: var(--nav-height);
      background: var(--parchment);
      border-bottom: 1px solid rgba(191,107,71,0.35);
      display: flex;
      align-items: center;
    }
    #nav > .wrap {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .backbar {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--ink-muted);
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      transition: color 0.25s ease, gap 0.25s ease;
    }
    .backbar:hover { color: var(--near-black); gap: 0.95rem; }

    .nav-meta {
      font-size: 10px;
      font-weight: 300;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    #scroll-progress {
      position: fixed;
      top: 0; left: 0;
      width: 2px;
      height: 0%;
      background: var(--terracotta);
      z-index: 60;
      will-change: height;
      transition: height 60ms linear;
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        transition-delay: 0ms !important;
      }
      .js-anim .reveal { opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>

<body>

  <a href="#main" class="skip-link">Skip to content</a>

  <div id="scroll-progress" aria-hidden="true"></div>

  <nav id="nav">
    <div class="wrap px-6 md:px-10">
      <a href="/#work" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <span class="nav-meta">Case study</span>
    </div>
  </nav>

  <main id="main">

    <!-- ── Hero ────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-16 md:pt-24 pb-16">
      <p class="eyebrow mb-6">Systems &middot; Self-initiated</p>
      <h1 class="display mb-8" style="font-size:clamp(2.75rem,7vw,5.5rem);max-width:16ch;">
        Booked, signed and paid, before they change their mind.
      </h1>
      <hr class="rule-terracotta mb-8">
      <p class="body-copy measure" style="font-size:1.1875rem;">
        Booking Engine is a client journey for regulated practices, where becoming a client happens in one sitting rather than across five separate handoffs. It runs three fictional practices on one engine: a solicitor, a chartered accountant and an aesthetics clinic. What follows is the accountancy practice, watched end to end.
      </p>

      <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-14 pt-8" style="border-top:1px solid rgba(28,23,18,0.12);">
        <div>
          <dt class="meta-key mb-2">Sector</dt>
          <dd class="text-sm font-light">Regulated professional services</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Scope</dt>
          <dd class="text-sm font-light">Journey architecture &middot; Rules design &middot; Prototype</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Shipped</dt>
          <dd class="text-sm font-light">3 tenants, 1 engine</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Status</dt>
          <dd class="text-sm font-light">Working prototype, open to try</dd>
        </div>
      </dl>
    </section>

    <!-- ── The demo ────────────────────────────────────────────── -->
    <section class="pt-4 pb-20 md:pb-28 reveal">
      <div class="wrap px-6 md:px-10">
        <div class="clip-frame">
          <video class="clip-video"
                 src="/assets/intake-onboarding.mp4"
                 poster="/assets/intake-onboarding.webp"
                 preload="none"
                 muted
                 loop
                 playsinline
                 width="1280"
                 height="720"
                 aria-label="A full onboarding run at Marbury Hale, chartered accountants: service selection, booking, risk screening, signing and payment"></video>
          <button type="button" class="clip-play" aria-label="Play recording: the full onboarding run">
            <span>
              <svg width="11" height="13" viewBox="0 0 11 13" aria-hidden="true">
                <path d="M11 6.5 0 13V0z" fill="#1C1712"/>
              </svg>
              Play the full run
            </span>
          </button>
        </div>
        <p class="text-xs font-light mt-4" style="color:var(--ink-muted);max-width:72ch;line-height:1.7;">
          Recorded 9 August 2026 against the live prototype, switched to the Marbury Hale tenant. Nothing is staged: the rule trace on the right is firing against the actual selections made in the run, the signature is drawn live, and the confirmation reference is real for this take.
        </p>
      </div>
    </section>

    <!-- ── The challenge ───────────────────────────────────────── -->
    <section style="background:var(--blush);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
          <div class="reveal">
            <p class="eyebrow mb-5">The challenge</p>
            <p class="display" style="font-size:clamp(3.5rem,8vw,6rem);line-height:0.9;">5</p>
            <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
              The handoffs a regulated practice usually asks a new client to sit through before any work begins.
            </p>
          </div>
          <div class="reveal flex flex-col gap-6">
            <h2 class="display mb-2" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:22ch;">
              A regulated practice doesn't lose a client to bad design.
            </h2>
            <p class="body-copy">
              It loses them between the enquiry and the engagement: a call to book, an email with the letter of engagement attached, a chase for the signature, a separate call to take the deposit. Every one of those is a place for someone with three other quotes open in other tabs to simply not get back to it.
            </p>
            <p class="body-copy">
              None of that is a design problem. A nicer enquiry form does not remove a single handoff. Removing the handoffs is a systems problem, which is what this had to be built as.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── The insight ─────────────────────────────────────────── -->
    <section class="oncolour" style="background:var(--near-black);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28 reveal">
        <hr class="rule-terracotta mb-6">
        <p class="eyebrow mb-8" style="color:var(--blush);">The insight</p>
        <h2 class="display" style="font-size:clamp(1.875rem,4vw,3.25rem);color:var(--parchment);max-width:32ch;">
          Conversion, for a regulated practice, is not a landing page problem. It is every extra step between interested and signed, so the fix is removing the steps, not decorating them.
        </h2>
      </div>
    </section>

    <!-- ── What was built ──────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="mb-12 reveal">
        <p class="eyebrow mb-5">What was built</p>
        <h2 class="display" style="font-size:clamp(2rem,4vw,3rem);max-width:20ch;">
          Five decisions that set everything else.
        </h2>
      </div>
      <div class="reveal">
        {built.map((item, i) => (
          <div class="built-row">
            <span class="built-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="display mb-3" style="font-size:1.5rem;">{item.t}</h3>
              <p class="body-copy" style="font-size:1rem;max-width:64ch;">{item.d}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── What shipped ────────────────────────────────────────── -->
    <section style="background:var(--blush);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="mb-12 reveal">
          <p class="eyebrow mb-5">What shipped</p>
          <h2 class="display" style="font-size:clamp(2rem,4vw,3rem);max-width:22ch;">
            The practice's own site, and the ledger running behind it.
          </h2>
          <p class="body-copy measure mt-6">
            Marbury Hale's site carries its own key dates and fee schedule, no photography, dense and ruled, the way a firm of accountants actually reads. Beside the client's journey sits the practice's own view: the exact rule that required each question, before a booking slot was even offered.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          <figure class="reveal">
            <div class="shot">
              <Image src={marburyHero} alt="The Marbury Hale site: chartered accountants, a key-dates panel for the 2026/27 tax year, and the onboarding entry point"
                     widths={[560, 900, 1800]}
                     sizes="(min-width: 768px) 540px, 100vw"
                     format="webp" quality={78} loading="lazy" decoding="async" />
            </div>
            <figcaption class="shot-cap">Marbury Hale, the tenant site</figcaption>
          </figure>

          <figure class="reveal">
            <div class="shot">
              <Image src={ruleTraceDetail} alt="The rule trace panel mid-journey: numbered AML, due-diligence and engagement rules, each with the value that fired it"
                     widths={[560, 900, 1800]}
                     sizes="(min-width: 768px) 540px, 100vw"
                     format="webp" quality={78} loading="lazy" decoding="async" />
            </div>
            <figcaption class="shot-cap">The rule trace, mid-journey</figcaption>
          </figure>
        </div>

        <div class="mt-14 pt-10 reveal" style="border-top:1px solid rgba(28,23,18,0.12);">
          <a href="/work/booking-engine/prototype/" class="cta-ghost">
            Open the prototype yourself
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M1 6.5h11M7.5 1.5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ── What it's worth ─────────────────────────────────────── -->
    <!-- Added 9 Aug 2026, per Osman: the credibility case needs a £ figure,
         not just hours saved, but Intake has no live client yet to draw a
         real result from. Modelled and clearly labelled as such, rather
         than presented as a client outcome, matches the "not staged"
         disclosure standard the rest of the piece already holds itself to. -->
    <section class="wrap px-6 md:px-10 pt-20 md:pt-28 pb-8 md:pb-10">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">What it's worth</p>
          <p class="display" style="font-size:clamp(3rem,7vw,5rem);line-height:0.95;">&pound;194k</p>
          <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
            Modelled annual revenue, closing the triage gap for one practice like Thackray Vane. Not a client result.
          </p>
        </div>
        <div class="reveal flex flex-col gap-6">
          <p class="body-copy">
            A practice of this size runs roughly 200 enquiries a month, 2,400 a year, and converts around 3 in 10 into an instructed client under a multi-day, multi-handoff process. Closing the gap between enquiry and instruction to one sitting is worth, conservatively, a 15% relative lift in that conversion rate: from 30% to 34.5%.
          </p>
          <p class="body-copy">
            That's 108 more instructed clients a year. At an average case value of &pound;1,800, a fixed-fee residential conveyance, that's roughly &pound;194,000 in additional annual revenue, from the same enquiries the practice was already paying to generate.
          </p>
          <div class="mt-2 pt-6" style="border-top:1px solid rgba(28,23,18,0.12);">
            <p class="text-xs font-light" style="color:var(--ink-muted);line-height:1.7;max-width:64ch;">
              <b style="color:var(--near-black);font-weight:600;">Modelled, not measured.</b> Intake has no live client yet, so this is a calculation from stated assumptions, not a result. 200 enquiries/month, 30% baseline conversion and &pound;1,800 average case value are illustrative figures for a practice like Thackray Vane; the 15% uplift is a conservative estimate for removing days of handoffs from the booking journey, not a measured A/B result. Change any input and the number changes with it, the mechanism is what's real.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Where it stands ─────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-20 md:pt-28 pb-8 md:pb-10">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">Where it stands</p>
          <h2 class="display" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:16ch;">
            A working prototype, not a pitch deck.
          </h2>
        </div>
        <div class="reveal flex flex-col gap-6">
          <p class="body-copy">
            All three tenants are live and open to try, built to be taken apart rather than only looked at. Nothing here is mocked up: the rules fire for real, the slot holds for real, the signature hashes for real.
          </p>
          <p class="body-copy">
            Wiring it to a real calendar, a real payment provider and a real client record is integration work, not redesign. The engine and the rules are already doing the real work.
          </p>
        </div>
      </div>
    </section>

    <!-- ── CTA ─────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="reveal">
        <h2 class="display mb-8" style="font-size:clamp(1.875rem,4vw,3rem);max-width:22ch;">
          Losing prospects somewhere between interested and signed?
        </h2>
        <a href="/#contact" class="cta">Start a project</a>
      </div>
    </section>

  </main>

  <footer class="wrap px-6 md:px-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-10" style="border-top:1px solid rgba(28,23,18,0.12);">
      <a href="/" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <p class="text-xs font-light" style="color:var(--ink-muted);">
        Booking Engine case study. Self-initiated. Published by Main Stage Studio.
      </p>
    </div>
  </footer>

  <script>
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.height = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }, { passive: true });
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    document.querySelectorAll('.clip-frame').forEach(frame => {
      const video = frame.querySelector('video');
      const button = frame.querySelector('.clip-play');
      if (!video || !button) return;

      button.addEventListener('click', () => {
        frame.classList.add('is-playing');
        video.controls = true;
        video.play();
        video.focus();
      });

      const vis = new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting && !video.paused) video.pause();
        });
      }, { threshold: 0.25 });
      vis.observe(frame);
    });
  </script>

</body>
</html>
