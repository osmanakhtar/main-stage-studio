---
import { Image } from 'astro:assets';
import '../../../styles/global.css';

// Case study 1 of 3, split out from the single combined "Booking Engine"
// piece per Osman, 17 Aug 2026: multi-tenancy is an MSS engineering flex,
// not something a conveyancing prospect cares about. This page reads as a
// system built specifically for conveyancing, full stop. It borrows
// Thackray Vane's own palette and type from the prototype (claret, brass,
// Newsreader/IBM Plex Sans) rather than MSS's own tokens, so the page feels
// like a different product, not a recoloured template. Multi-tenancy is
// mentioned once, near the end, as a capacity note rather than the claim.

import thackrayHero from '../../../assets/intake-thackray-hero.jpg';

const built = [
  {
    t: 'The whole cost, before you instruct',
    d: 'RULE-002 built into the layout, not asserted in copy: the firm’s fee and every disbursement, itemised with VAT treatment, before a client commits to anything. There is no code path that lets the page show a headline fee instead.',
  },
  {
    t: 'A conflict can stop the journey outright',
    d: 'RULE-011 asks whether the firm has already been approached by the other party. Answer yes, and the journey ends there, with the reason on the page and in the trace. A firm cannot act for both sides and cannot ask a client to waive that, so there is no continue button and no reroute.',
  },
  {
    t: 'The chain, drawn as a sequence',
    d: 'A conveyance is five stages with a chain attached, so the site is built as a numbered rail rather than a form. The client always knows which of the five they are in and what happens next.',
  },
  {
    t: 'Identity and source of funds, in the same sitting',
    d: 'The highest-evidence intake in the profession, done once, in the flow, with a signed record at the end rather than a chase for documents over email after the fact.',
  },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Conveyancing client onboarding, a case study | Main Stage Studio</title>
  <meta name="description" content="A client onboarding system built for residential conveyancing: every fee itemised because the rule requires it, and a conflict check that can stop the journey outright.">
  <meta property="og:title" content="Conveyancing client onboarding, a case study | Main Stage Studio">
  <meta property="og:description" content="Watch a firm of solicitors take on a new matter end to end: quoted, screened, itemised and instructed, in one sitting.">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

  <script is:inline>document.documentElement.classList.add('js-anim');</script>

  <style>
    :root {
      --nav-height: 64px;
      --bone:   #F4F1EC;
      --stone:  #DDD6CE;
      --claret: #6B2434;
      --claret-hover: #82303F;
      --gold:   #9A8556;
      /* Accessibility split (17 Aug 2026). --gold stays the decorative accent
         (hairline rules, large display italics, which clear 3:1). Small text
         needs 4.5:1 and uses --gold-text. */
      --gold-text: #695B3B;
      /* On the dark ink section the accent must go the other way, so the
         original gold is reused there. */
      --gold-on-dark: #9A8556;
      --ink:    #241417;
      --ink-muted: #625B5C;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { background: var(--bone); scroll-behavior: smooth; }
    body {
      font-family: 'IBM Plex Sans', system-ui, sans-serif;
      font-weight: 300;
      background: var(--bone);
      color: var(--ink);
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      padding-top: var(--nav-height);
    }

    .wrap { max-width: 1120px; margin-inline: auto; }
    .measure { max-width: 62ch; }

    .display {
      font-family: 'Newsreader', Georgia, serif;
      font-weight: 400;
      letter-spacing: -0.01em;
      line-height: 1.12;
      text-wrap: balance;
    }
    .display em { font-style: italic; color: var(--gold); }

    .eyebrow {
      font-size: 0.625rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold-text);
    }
    .oncolour .eyebrow { color: var(--gold-on-dark); }

    .body-copy {
      font-weight: 300;
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--ink-muted);
    }

    .rule { width: 56px; height: 1px; background: var(--gold); border: none; opacity: .8; }

    .meta-key {
      font-size: 0.5625rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .built-row {
      display: grid;
      grid-template-columns: 3rem 1fr;
      gap: 1.5rem;
      padding: 2rem 0;
      border-top: 1px solid rgba(36,20,23,0.12);
    }
    .built-row:last-child { border-bottom: 1px solid rgba(36,20,23,0.12); }
    .built-num {
      font-family: 'Newsreader', Georgia, serif;
      font-size: 1.5rem;
      color: var(--gold);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .shot { border: 1px solid rgba(36,20,23,0.14); overflow: hidden; display: block; }
    .shot img { display: block; width: 100%; height: auto; }
    .shot-cap { margin-top: 0.75rem; font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-muted); }

    .cta {
      position: relative; display: inline-flex; align-items: center; gap: 0.6rem;
      overflow: hidden; background: var(--ink); color: var(--bone);
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; padding: 1rem 2.25rem; will-change: transform;
    }
    .cta__bg { position: absolute; inset: 0; background: var(--claret); transform: translateX(-101%); transition: transform 0.45s cubic-bezier(0.16,1,0.3,1); pointer-events: none; }
    .cta:hover .cta__bg { transform: translate(0,0); }
    .cta__label { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 0.6rem; }
    .cta:active { transform: translateY(1px) scale(0.98); }

    .cta-ghost {
      display: inline-flex; align-items: center; gap: 0.6rem; color: var(--claret);
      font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
      text-decoration: none; border-bottom: 1px solid rgba(107,36,52,0.35); padding-bottom: 2px;
      transition: border-color 0.25s ease;
    }
    .cta-ghost:hover { border-color: var(--claret); }

    :focus-visible { outline: 2px solid var(--claret); outline-offset: 3px; }
    .oncolour :focus-visible { outline-color: var(--gold); }

    .skip-link { position: absolute; left: 1rem; top: -100px; z-index: 50; background: var(--ink); color: var(--bone); font-size: 0.8125rem; padding: 0.75rem 1.25rem; text-decoration: none; transition: top 0.2s ease; }
    .skip-link:focus { top: 1rem; }

    .reveal { opacity: 1; }
    .js-anim .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16,1,0.3,1), transform 0.8s cubic-bezier(0.16,1,0.3,1); }
    .js-anim .reveal.in-view { opacity: 1; transform: translateY(0); }

    #nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: var(--nav-height);
      background: var(--bone); border-bottom: 1px solid rgba(154,133,86,0.4);
      display: flex; align-items: center;
    }
    #nav > .wrap { width: 100%; display: flex; align-items: center; justify-content: space-between; }
    .backbar { display: inline-flex; align-items: center; gap: 0.65rem; text-decoration: none; color: var(--ink-muted); font-size: 0.75rem; letter-spacing: 0.04em; transition: color 0.25s ease, gap 0.25s ease; }
    .backbar:hover { color: var(--ink); gap: 0.95rem; }
    .nav-meta { font-size: 10px; font-weight: 400; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-muted); }

    #scroll-progress { position: fixed; top: 0; left: 0; width: 2px; height: 0%; background: var(--claret); z-index: 60; will-change: height; transition: height 60ms linear; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
      *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; transition-delay: 0ms !important; }
      .js-anim .reveal { opacity: 1 !important; transform: none !important; }
    }
  </style>
</head>

<body>

  <a href="#main" class="skip-link">Skip to content</a>
  <div id="scroll-progress" aria-hidden="true"></div>

  <nav id="nav">
    <div class="wrap px-6 md:px-10">
      <a href="/#work" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <span class="nav-meta">Case study &middot; Conveyancing</span>
    </div>
  </nav>

  <main id="main">

    <!-- ── Hero ────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-16 md:pt-24 pb-16">
      <p class="eyebrow mb-6">Systems &middot; Conveyancing</p>
      <h1 class="display mb-8" style="font-size:clamp(2.75rem,7vw,5.25rem);max-width:17ch;">
        The <em>whole</em> cost, before they instruct.
      </h1>
      <hr class="rule mb-8">
      <p class="body-copy measure" style="font-size:1.1875rem;">
        A client onboarding system built for residential conveyancing, where a fixed fee and every disbursement are itemised before a client commits to anything, because the rule requires it, not because the copy was written carefully. A prospect goes from enquiry to instructed matter in one sitting, with the identity, source-of-funds and conflict checks a firm is obliged to run built into the flow rather than chased afterwards.
      </p>

      <dl class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-14 pt-8" style="border-top:1px solid rgba(36,20,23,0.14);">
        <div>
          <dt class="meta-key mb-2">Sector</dt>
          <dd class="text-sm font-light">Residential conveyancing</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Scope</dt>
          <dd class="text-sm font-light">Journey architecture &middot; Rules design &middot; Prototype</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Regulator</dt>
          <dd class="text-sm font-light">SRA, incl. AML supervision</dd>
        </div>
        <div>
          <dt class="meta-key mb-2">Status</dt>
          <dd class="text-sm font-light">Working prototype, open to try</dd>
        </div>
      </dl>
    </section>

    <!-- ── The shot ────────────────────────────────────────────── -->
    <section class="pt-4 pb-20 md:pb-28 reveal">
      <div class="wrap px-6 md:px-10">
        <div class="shot">
          <Image src={thackrayHero} alt="Thackray Vane, solicitors: the practice's own site, its five-stage conveyance rail, and the itemised fee list beneath it"
                 widths={[560, 900, 1800]} sizes="100vw" format="webp" quality={78} loading="lazy" decoding="async" />
        </div>
        <p class="text-xs font-light mt-4" style="color:var(--ink-muted);max-width:72ch;line-height:1.7;">
          Thackray Vane's own site, captured live from the running prototype. The rail beneath the hero is the five stages of a conveyance, drawn as a sequence because a conveyance is one. Nothing here is a mock-up: the rules engine beside the journey fires against the actual selections a visitor makes.
        </p>
      </div>
    </section>

    <!-- ── The challenge ───────────────────────────────────────── -->
    <section style="background:var(--stone);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
          <div class="reveal">
            <p class="eyebrow mb-5">The challenge</p>
            <p class="display" style="font-size:clamp(3.5rem,8vw,6rem);line-height:0.9;color:var(--claret);">5</p>
            <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
              Distinct compliance checks before a firm can even quote.
            </p>
          </div>
          <div class="reveal flex flex-col gap-6">
            <h2 class="display mb-2" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:22ch;">
              Residential conveyancing carries the highest-evidence intake in the profession.
            </h2>
            <p class="body-copy">
              Identity, source of funds, an AML risk assessment, a conflict check, a client care letter, money on account: get any one of them wrong and it is a regulatory problem, not a UX one. Doing it well by hand means a person remembering every rule, every time, for every new enquiry.
            </p>
            <p class="body-copy">
              A nicer enquiry form does not remove that risk. The requirements have to be built into the flow so a step cannot be skipped by a busy Friday.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── The insight ─────────────────────────────────────────── -->
    <section class="oncolour" style="background:var(--ink);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28 reveal">
        <hr class="rule mb-6">
        <p class="eyebrow mb-8">The insight</p>
        <h2 class="display" style="font-size:clamp(1.875rem,4vw,3.25rem);color:var(--bone);max-width:32ch;">
          A firm cannot show a headline fee and cannot act for both sides. The system should make both of those true, not just the client care letter.
        </h2>
      </div>
    </section>

    <!-- ── What was built ──────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="mb-12 reveal">
        <p class="eyebrow mb-5">What was built</p>
        <h2 class="display" style="font-size:clamp(2rem,4vw,3rem);max-width:22ch;">
          Four decisions that carry the compliance weight.
        </h2>
      </div>
      <div class="reveal">
        {built.map((item, i) => (
          <div class="built-row">
            <span class="built-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="display mb-3" style="font-size:1.5rem;">{item.t}</h3>
              <p class="body-copy" style="font-size:1rem;max-width:64ch;">{item.d}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── What it's worth ─────────────────────────────────────── -->
    <section style="background:var(--stone);">
      <div class="wrap px-6 md:px-10 py-20 md:py-28">
        <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
          <div class="reveal">
            <p class="eyebrow mb-5">What it's worth</p>
            <p class="display" style="font-size:clamp(3rem,7vw,5rem);line-height:0.95;color:var(--claret);">&pound;194k</p>
            <p class="text-sm font-light mt-4" style="color:var(--ink-muted);max-width:24ch;">
              Modelled annual revenue, closing the triage gap for one firm of this size. Not a client result.
            </p>
          </div>
          <div class="reveal flex flex-col gap-6">
            <p class="body-copy">
              A practice of this size runs roughly 200 enquiries a month, 2,400 a year, and converts around 3 in 10 into an instructed matter under a multi-day, multi-handoff process. Closing the gap between enquiry and instruction to one sitting is worth, conservatively, a 15% relative lift in that conversion rate: from 30% to 34.5%.
            </p>
            <p class="body-copy">
              That's 108 more instructed matters a year. At an average case value of &pound;1,800, a fixed-fee residential conveyance, that's roughly &pound;194,000 in additional annual revenue, from the same enquiries the firm was already paying to generate.
            </p>
            <div class="mt-2 pt-6" style="border-top:1px solid rgba(36,20,23,0.14);">
              <p class="text-xs font-light" style="color:var(--ink-muted);line-height:1.7;max-width:64ch;">
                <b style="color:var(--ink);font-weight:600;">Modelled, not measured.</b> 200 enquiries/month, 30% baseline conversion and &pound;1,800 average case value are illustrative figures for a practice of this size; the 15% uplift is a conservative estimate for removing days of handoffs from the onboarding journey, not a measured A/B result. Change any input and the number changes with it, the mechanism is what's real.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Where it stands ─────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 pt-20 md:pt-28 pb-8 md:pb-10">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] gap-12 md:gap-20">
        <div class="reveal">
          <p class="eyebrow mb-5">Where it stands</p>
          <h2 class="display" style="font-size:clamp(1.75rem,3.2vw,2.5rem);max-width:16ch;">
            A working prototype, not a pitch deck.
          </h2>
        </div>
        <div class="reveal flex flex-col gap-6">
          <p class="body-copy">
            Open to try, built to be taken apart rather than only looked at. Nothing here is mocked up: the rules fire for real, the slot holds for real, the signature hashes for real.
          </p>
          <p class="body-copy">
            The same architecture also runs a chartered accountancy practice and a regulated aesthetics clinic, each configured on its own record, its own rules and its own vocabulary, and it scales the same way to a firm with several offices or partners sharing one practice. Wiring it to a real calendar, a real payment provider and a real client record is integration work, not redesign.
          </p>
        </div>
      </div>
    </section>

    <!-- ── CTA ─────────────────────────────────────────────────── -->
    <section class="wrap px-6 md:px-10 py-20 md:py-28">
      <div class="reveal">
        <h2 class="display mb-6" style="font-size:clamp(1.875rem,4vw,3rem);max-width:22ch;">
          Losing prospects between enquiry and instruction?
        </h2>
        <p class="body-copy measure mb-10">
          That's the gap this closes, dropped into the site you already have. Tell us about your practice, and we'll show you what it looks like running on your own intake.
        </p>
        <div class="flex flex-wrap items-center gap-8">
          <a href="/#contact" class="cta">
            <span class="cta__bg"></span>
            <span class="cta__label">Start a project</span>
          </a>
          <a href="/work/booking-engine/prototype/?tenant=thackray" class="cta-ghost">
            Open the prototype
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M1 6.5h11M7.5 1.5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="wrap px-6 md:px-10 pb-10">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-10" style="border-top:1px solid rgba(36,20,23,0.14);">
      <a href="/" class="backbar">
        <svg width="14" height="14" viewBox="0 0 13 13" fill="none" aria-hidden="true">
          <path d="M12 6.5H1M5.5 11.5l-5-5 5-5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Main Stage Studio
      </a>
      <p class="text-xs font-light" style="color:var(--ink-muted);">
        Conveyancing onboarding case study. Self-initiated. Published by Main Stage Studio.
      </p>
    </div>
  </footer>

  <script>
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progressBar.style.height = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
      }, { passive: true });
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>

</body>
</html>
