            <input type="text" id="name" name="name" class="finput" placeholder="Your name" autocomplete="name" required>
            <p class="font-sans text-terracotta hidden" id="err-name" style="font-size:0.75rem;margin-top:3px;">Please enter your name.</p>
          </div>

          <div class="flex flex-col gap-[5px]">
            <label for="email" class="flabel">Email</label>
            <input type="email" id="email" name="email" class="finput" placeholder="your@email.com" autocomplete="email" required>
            <p class="font-sans text-terracotta hidden" id="err-email" style="font-size:0.75rem;margin-top:3px;">Please enter a valid email address.</p>
          </div>

          <div class="flex flex-col gap-[5px]">
            <label for="project" class="flabel">Tell me about your project</label>
            <textarea id="project" name="project" class="finput" placeholder="What are you working on, and where are you with it?" rows="5" required></textarea>
            <p class="font-sans text-terracotta hidden" id="err-project" style="font-size:0.75rem;margin-top:3px;">Please tell us about your project.</p>
          </div>

          <div class="flex items-center gap-6 flex-wrap">
            <button type="submit" class="btn-fill" id="submit-btn">
              <span class="btn-fill__bg"></span>
              <span class="btn-fill__label">Send it over</span>
            </button>
            <p class="font-sans font-light text-near-black" style="font-size:0.8125rem;opacity:0.4;">
              Or email <a href="mailto:hello@mainstagestudio.co.uk" class="underline underline-offset-2 transition-colors hover:text-terracotta" style="opacity:1;font-size:1rem;">hello@mainstagestudio.co.uk</a>
            </p>
          </div>

          <!-- Success -->
          <div id="form-success" class="hidden items-start gap-4 py-5 px-5 border" style="border-color:rgba(28,23,18,0.1);background:rgba(28,23,18,0.03);">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true" class="shrink-0 mt-0.5">
              <circle cx="9" cy="9" r="8" stroke="#BF6B47" stroke-width="1.2"/>
              <path d="M5.5 9l2.5 2.5 4.5-4.5" stroke="#BF6B47" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <p class="font-sans font-medium text-near-black" style="font-size:0.9375rem;">Got it — thank you.</p>
              <p class="font-sans font-light text-near-black mt-1" style="font-size:0.875rem;opacity:0.5;">I read everything that comes through here and you'll hear back from me within two working days.</p>
            </div>
          </div>

        </form>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════ FOOTER -->
