  <script>
    // ── SCROLL PROGRESS ───────────────────────────────────────────────────
    const progressBar = document.getElementById('scroll-progress');
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progressBar.style.width = (window.scrollY / max * 100) + '%';
    };
    window.addEventListener('scroll', updateProgress, { passive: true });

    // ── NAV ───────────────────────────────────────────────────────────────
    const nav = document.getElementById('nav');
    const navCta = document.getElementById('nav-cta');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        nav.style.pointerEvents = 'none';
        const el = document.elementFromPoint(
          window.innerWidth / 2,
          nav.getBoundingClientRect().bottom + 2
        );
        nav.style.pointerEvents = '';
        const isDark = el && el.closest('[data-nav-dark]');
        nav.classList.toggle('scrolled-dark', !!isDark);
        nav.classList.toggle('scrolled-light', !isDark);
        if (navCta) navCta.classList.toggle('light', !!isDark);
      } else {
        nav.classList.remove('scrolled-light', 'scrolled-dark');
        if (navCta) navCta.classList.remove('light');
      }
    }, { passive: true });

    // ── HERO LINE REVEAL ──────────────────────────────────────────────────
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.body.classList.add('lines-ready');
      });
    });

    // ── HERO VIDEO ────────────────────────────────────────────────────────
    const heroVideo = document.getElementById('hero-video');
    if (heroVideo) {
      heroVideo.playbackRate = 0.75;
      const showVideo = () => { heroVideo.style.opacity = '1'; };
      heroVideo.addEventListener('canplay', showVideo, { once: true });
      heroVideo.addEventListener('play', showVideo, { once: true });
      heroVideo.addEventListener('ended', () => {
        heroVideo.pause();
      }, { once: true });
      heroVideo.play().catch(() => {});
    }

    // ── MOBILE MENU ───────────────────────────────────────────────────────
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');
    let menuOpen = false;

    menuToggle.addEventListener('click', () => {
      menuOpen = !menuOpen;
      mobileMenu.style.transform = menuOpen ? 'translateX(0)' : 'translateX(100%)';
      mobileMenu.setAttribute('aria-hidden', String(!menuOpen));
      menuToggle.setAttribute('aria-expanded', String(menuOpen));
      document.body.style.overflow = menuOpen ? 'hidden' : '';
      bar1.style.transform = menuOpen ? 'translateY(6px) rotate(45deg)' : '';
      bar2.style.opacity   = menuOpen ? '0' : '1';
      bar3.style.transform = menuOpen ? 'translateY(-6px) rotate(-45deg)' : '';
    });
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        if (!menuOpen) return;
        menuOpen = false;
        mobileMenu.style.transform = 'translateX(100%)';
        mobileMenu.setAttribute('aria-hidden', 'true');
        menuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        bar1.style.transform = bar3.style.transform = '';
        bar2.style.opacity = '1';
      });
    });

    // ── MSS FEATURED IMAGE FADE ───────────────────────────────────────────
    const mssThumb = document.getElementById('mss-thumb-img');
    if (mssThumb) {
      mssThumb.style.opacity = '0';
      window.addEventListener('load', () => {
        setTimeout(() => {
          mssThumb.style.opacity = '1';
        }, 600);
      });
    }

    // ── SCROLL REVEAL ─────────────────────────────────────────────────────
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // ── SPOTLIGHT BORDER ──────────────────────────────────────────────────
    document.querySelectorAll('.spotlight-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top)  + 'px');
      });
    });

    // ── SYSTEM PROGRESS LINE ──────────────────────────────────────────────
    const systemSection = document.getElementById('how-it-works');
    const systemLine    = document.getElementById('system-line');
    const updateLine = () => {
      if (!systemSection) return;
      const r = systemSection.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -r.top / (r.height - window.innerHeight)));
      systemLine.style.transform = `scaleY(${progress})`;
    };
    window.addEventListener('scroll', updateLine, { passive: true });

    // ── DIRECTIONAL FILL BUTTONS ──────────────────────────────────────────
    document.querySelectorAll('.btn-fill').forEach(btn => {
      btn.addEventListener('mouseenter', e => {
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        btn.classList.remove('from-right', 'from-top', 'from-bottom');
        if      (x > r.width  * 0.7) btn.classList.add('from-right');
        else if (y < r.height * 0.3) btn.classList.add('from-top');
        else if (y > r.height * 0.7) btn.classList.add('from-bottom');
      });
    });

    // ── FORM ──────────────────────────────────────────────────────────────
    const form      = document.getElementById('contact-form');
    const successEl = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');
    const submitLbl = submitBtn.querySelector('.btn-fill__label');

    const validators = [
      { id:'name',    err:'err-name',    ok: v => v.trim().length > 0 },
      { id:'email',   err:'err-email',   ok: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
      { id:'project', err:'err-project', ok: v => v.trim().length > 0 },
    ];

    validators.forEach(({ id, err }) => {
      document.getElementById(id).addEventListener('input', () => {
        document.getElementById(err).classList.add('hidden');
      });
    });

    form.addEventListener('submit', async e => {
      e.preventDefault();
      let valid = true;
      validators.forEach(({ id, err, ok }) => {
        const el  = document.getElementById(id);
        const msg = document.getElementById(err);
        const pass = ok(el.value);
        msg.classList.toggle('hidden', pass);
        if (!pass) valid = false;
      });
      if (!valid) return;

      submitLbl.textContent = 'Sending…';
      submitBtn.disabled = true;

      try {
        const response = await fetch('https://formspree.io/f/mnjyqooa', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form),
        });

        if (response.ok) {
          form.querySelectorAll('.flex.flex-col').forEach(el => {
            el.style.opacity = '0.25';
            el.style.pointerEvents = 'none';
          });
          form.querySelector('.flex.items-center.gap-6').style.opacity = '0.25';
          successEl.classList.remove('hidden');
          successEl.classList.add('flex');
        } else {
          submitLbl.textContent = 'Send it over';
          submitBtn.disabled = false;
          alert('Something went wrong. Please try emailing us directly at hello@mainstagestudio.co.uk');
        }
      } catch {
        submitLbl.textContent = 'Send it over';
        submitBtn.disabled = false;
        alert('Something went wrong. Please try emailing us directly at hello@mainstagestudio.co.uk');
      }
    });
  </script>

</body>
