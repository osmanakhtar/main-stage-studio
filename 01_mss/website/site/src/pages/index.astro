---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Main Stage Studio — Brand, Web &amp; Content, Built and Run</title>
  <meta name="description" content="Main Stage Studio builds your brand, website, and content — then runs them. One system, one place to review everything, a presence that doesn't go quiet.">
  <meta property="og:title" content="Main Stage Studio — Launched is not the same as alive.">
  <meta property="og:description" content="Brand, website, and content — built once, run every week. Reviewed and approved by you, in one place.">

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect x='14' y='2' width='24' height='22' rx='3' fill='%231C1712'/%3E%3Crect x='2' y='16' width='24' height='22' rx='3' fill='%23BF6B47'/%3E%3Crect x='14' y='16' width='12' height='8' rx='1.5' fill='%23F5EFE5'/%3E%3C/svg%3E">
  <link rel="alternate icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect x='14' y='2' width='24' height='22' rx='3' fill='%231C1712'/%3E%3Crect x='2' y='16' width='24' height='22' rx='3' fill='%23BF6B47'/%3E%3Crect x='14' y='16' width='12' height='8' rx='1.5' fill='%23F5EFE5'/%3E%3C/svg%3E">
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='6' fill='%23F5EFE5'/%3E%3Crect x='14' y='2' width='24' height='22' rx='3' fill='%231C1712'/%3E%3Crect x='2' y='16' width='24' height='22' rx='3' fill='%23BF6B47'/%3E%3Crect x='14' y='16' width='12' height='8' rx='1.5' fill='%23F5EFE5'/%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --parchment:  #F5EFE5;
      --blush:      #E8C9AE;
      --terracotta: #BF6B47;
      --ember:      #8C4A2F;
      --near-black: #1C1712;
      --muted:      #706B65;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; }

    html { background: var(--parchment); }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      background: var(--parchment);
      color: var(--near-black);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Scroll progress ─────────────────────────────────────── */
    #scroll-progress {
      position: fixed;
      top: 0; left: 0;
      height: 1px;
      width: 0%;
      background: var(--terracotta);
      z-index: 100;
      transition: width 0.05s linear;
    }

    /* ── Nav ─────────────────────────────────────────────────── */
    #nav {
      border-bottom: 1px solid transparent;
      transition: background-color    0.45s cubic-bezier(0.16,1,0.3,1),
                  border-bottom-color 0.45s cubic-bezier(0.16,1,0.3,1),
                  box-shadow          0.45s cubic-bezier(0.16,1,0.3,1);
    }
    #nav.scrolled-light {
      background: var(--parchment) !important;
      border-bottom-color: rgba(28,23,18,0.15) !important;
      box-shadow: 0 1px 0 rgba(28,23,18,0.12);
    }
    #nav.scrolled-dark {
      background: var(--near-black) !important;
      border-bottom-color: rgba(245,239,229,0.1) !important;
      box-shadow: 0 1px 0 rgba(245,239,229,0.08);
    }
    #nav.scrolled-dark .wordmark-main,
    #nav.scrolled-dark .nav-link { color: var(--parchment) !important; }
    #nav.scrolled-dark #bar1,
    #nav.scrolled-dark #bar2,
    #nav.scrolled-dark #bar3 { background: var(--parchment) !important; }

    .nav-link {
      position: relative;
      font-size: 0.8125rem;
      letter-spacing: 0.05em;
      text-decoration: none;
      color: var(--near-black);
      transition: color 0.45s cubic-bezier(0.16,1,0.3,1);
    }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -2px; left: 0;
      width: 0; height: 1px;
      background: var(--terracotta);
      transition: width 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    .nav-link:hover::after { width: 100%; }

    /* ── Directional fill button ─────────────────────────────── */
    .btn-fill {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      overflow: hidden;
      padding: 0.8rem 1.625rem;
      background: var(--near-black);
      color: var(--parchment);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none;
      border: none;
      cursor: pointer;
      will-change: transform;
    }
    .btn-fill__bg {
      position: absolute;
      inset: 0;
      background: var(--terracotta);
      transform: translateX(-101%);
      transition: transform 0.45s cubic-bezier(0.16,1,0.3,1);
      pointer-events: none;
    }
    .btn-fill.from-right  .btn-fill__bg { transform: translateX(101%); }
    .btn-fill.from-top    .btn-fill__bg { transform: translateY(-101%); }
    .btn-fill.from-bottom .btn-fill__bg { transform: translateY(101%); }
    .btn-fill:hover       .btn-fill__bg { transform: translate(0,0); }
    .btn-fill__label { position: relative; z-index: 1; }
    .btn-fill:active { transform: translateY(1px) scale(0.98); }
    .btn-fill:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-fill.light { background: var(--parchment); color: var(--near-black); }
    .btn-fill.light .btn-fill__bg { background: var(--near-black); }
    .btn-fill.light:hover .btn-fill__label { color: var(--parchment); }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
      color: var(--near-black);
      text-decoration: none;
      transition: color 0.3s ease, gap 0.3s cubic-bezier(0.16,1,0.3,1);
    }
    .btn-ghost:hover { color: var(--terracotta); gap: 0.7rem; }

    /* ── Hero video ──────────────────────────────────────────── */
    .mss-hero-video-wrap {
      position: relative;
      height: 45vh;
      width: 100%;
      pointer-events: none;
      user-select: none;
      overflow: hidden;
      z-index: 0;
    }
    .mss-hero-video-wrap video {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
      opacity: 0;
      transition: opacity 1.6s cubic-bezier(0.16,1,0.3,1);
    }
    @media (max-width: 767px) {
      .mss-hero-video-wrap video {
        -webkit-mask-image: linear-gradient(to bottom, black 30%, transparent 88%);
        mask-image: linear-gradient(to bottom, black 30%, transparent 88%);
      }
    }
    @media (min-width: 768px) {
      .mss-hero-video-wrap {
        position: absolute;
        top: 0; bottom: 0; right: 0;
        height: auto;
        width: 52%;
      }
      .mss-hero-video-wrap video {
        -webkit-mask-image: radial-gradient(ellipse 78% 72% at 58% 50%, black 10%, black 28%, transparent 68%);
        mask-image: radial-gradient(ellipse 78% 72% at 58% 50%, black 10%, black 28%, transparent 68%);
      }
    }

    /* ── Hero line reveal ────────────────────────────────────── */
    .line-clip { overflow: hidden; display: block; }
    .line-clip__inner {
      display: block;
      transform: translateY(105%);
      transition: transform 1.4s cubic-bezier(0.16,1,0.3,1);
    }
    .lines-ready .line-clip__inner { transform: translateY(0); }

    /* ── Muted body copy ─────────────────────────────────────── */
    .muted-text { color: var(--muted); }

    /* ── Section label ───────────────────────────────────────── */
    .slabel {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--terracotta);
    }

    /* ── Scroll reveal ───────────────────────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.85s cubic-bezier(0.16,1,0.3,1),
                  transform 0.85s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal.in-view { opacity: 1; transform: translateY(0); }
    .rd1 { transition-delay: 0.1s; }
    .rd2 { transition-delay: 0.22s; }
    .rd3 { transition-delay: 0.36s; }
    .rd4 { transition-delay: 0.5s; }

    /* ── Work thumbnail image fade ───────────────────────────── */
    .reveal .work-thumb-inner {
      opacity: 0;
      transition: opacity 1.1s cubic-bezier(0.16,1,0.3,1) 0.3s,
                  transform 0.75s cubic-bezier(0.16,1,0.3,1);
    }
    .reveal.in-view .work-thumb-inner { opacity: 1; }

    /* ── MSS featured image ──────────────────────────────────── */
    #mss-thumb-img {
      opacity: 0;
      transition: opacity 1.4s cubic-bezier(0.16,1,0.3,1);
    }

    /* ── Marquee ─────────────────────────────────────────────── */
    @keyframes marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    .marquee-track { animation: marquee 36s linear infinite; }
    .marquee-track:hover { animation-play-state: paused; }

    /* ── Spotlight border card ───────────────────────────────── */
    .spotlight-card {
      position: relative;
      isolation: isolate;
      border: 1px solid rgba(28,23,18,0.08);
      transition: border-color 0.3s ease;
    }
    .spotlight-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        480px circle at var(--mx, 50%) var(--my, 50%),
        rgba(191,107,71,0.22),
        transparent 55%
      );
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: 2;
    }
    .spotlight-card:hover::before { opacity: 1; }
    .spotlight-card > * { position: relative; z-index: 1; }

    /* ── Work thumbnail ──────────────────────────────────────── */
    .work-thumb { overflow: hidden; }
    .work-thumb-inner {
      width: 100%; height: 100%;
      transition: transform 0.75s cubic-bezier(0.16,1,0.3,1);
    }
    .spotlight-card:hover .work-thumb-inner { transform: scale(1.03); }
    #work-mss.spotlight-card:hover #mss-thumb-img { transform: scale(1.03); }

    /* ── System progress line ────────────────────────────────── */
    #system-line {
      position: absolute;
      left: 0; top: 0;
      width: 1px;
      height: 100%;
      background: var(--terracotta);
      transform-origin: top center;
      transform: scaleY(0);
      will-change: transform;
      opacity: 0.6;
    }

    /* ── Honesty callout ─────────────────────────────────────── */
    .honesty-box {
      border-left: 2px solid var(--terracotta);
      background: rgba(245,239,229,0.03);
    }

    /* ── Pulse dot ───────────────────────────────────────────── */
    @keyframes pulseDot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: 0.3; transform: scale(0.75); }
    }
    .pulse-dot { animation: pulseDot 2.8s ease-in-out infinite; }

    /* ── Form ────────────────────────────────────────────────── */
    .flabel {
      font-size: 0.625rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28,23,18,0.4);
      display: block;
    }
    .finput {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(28,23,18,0.16);
      padding: 0.75rem 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 1rem;
      font-weight: 300;
      color: var(--near-black);
      outline: none;
      transition: border-color 0.3s ease;
      -webkit-appearance: none;
    }
    .finput:focus { border-bottom-color: var(--terracotta); }
    .finput::placeholder { color: rgba(28,23,18,0.24); }
    textarea.finput { resize: none; }

    hr {
      border: none;
      border-top: 1px solid rgba(28,23,18,0.09);
    }
    .hr-light { border-top-color: rgba(245,239,229,0.08); }

  </style>
</head>

<body>

  <!-- Scroll progress indicator -->
  <div id="scroll-progress" aria-hidden="true"></div>


  <!-- ═══════════════════════════════════════ NAV -->
  <nav id="nav" class="fixed top-0 left-0 right-0 z-50 px-6 md:px-12 py-5 flex items-center justify-between">

    <a href="#" class="flex items-center gap-3 no-underline" aria-label="Main Stage Studio — home">
      <svg width="30" height="30" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="14" y="2"  width="24" height="22" rx="2.5" fill="#1C1712"/>
        <rect x="2"  y="16" width="24" height="22" rx="2.5" fill="#BF6B47"/>
        <rect x="14" y="16" width="12" height="8"  rx="1.5" fill="#F5EFE5"/>
      </svg>
      <span class="flex items-baseline gap-[0.3em]">
        <span class="wordmark-main font-display font-normal text-near-black" style="font-size:1.0625rem;letter-spacing:0.02em;">Main Stage</span>
        <span class="font-sans font-normal text-terracotta uppercase" style="font-size:0.5625rem;letter-spacing:0.24em;">Studio</span>
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="#what-we-do"   class="nav-link font-sans">What we do</a>
      <a href="#how-it-works" class="nav-link font-sans">How it works</a>
      <a href="#work"         class="nav-link font-sans">Work</a>
      <a href="#studio"       class="nav-link font-sans">The studio</a>
      <a href="#contact" id="nav-cta" class="btn-fill ml-2">
        <span class="btn-fill__bg"></span>
        <span class="btn-fill__label">Start a project</span>
      </a>
    </div>

    <button id="menu-toggle" class="md:hidden p-2 flex flex-col gap-[5px]" aria-label="Toggle menu" aria-expanded="false">
      <span id="bar1" class="block w-5 h-px bg-near-black origin-center" style="transition:transform 0.35s cubic-bezier(0.16,1,0.3,1);"></span>
      <span id="bar2" class="block w-5 h-px bg-near-black" style="transition:opacity 0.2s ease;"></span>
      <span id="bar3" class="block w-5 h-px bg-near-black origin-center" style="transition:transform 0.35s cubic-bezier(0.16,1,0.3,1);"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-parchment flex flex-col justify-center px-8"
       style="transform:translateX(100%);transition:transform 0.55s cubic-bezier(0.16,1,0.3,1);" aria-hidden="true">
    <nav class="flex flex-col gap-8">
      <a href="#what-we-do"   class="font-display font-normal text-near-black no-underline mobile-link" style="font-size:clamp(2.25rem,8vw,4rem);">What we do</a>
      <a href="#how-it-works" class="font-display font-normal text-near-black no-underline mobile-link" style="font-size:clamp(2.25rem,8vw,4rem);">How it works</a>
      <a href="#work"         class="font-display font-normal text-near-black no-underline mobile-link" style="font-size:clamp(2.25rem,8vw,4rem);">Work</a>
      <a href="#studio"       class="font-display font-normal text-near-black no-underline mobile-link" style="font-size:clamp(2.25rem,8vw,4rem);">The studio</a>
      <a href="#contact" class="btn-fill self-start mt-6 mobile-link">
        <span class="btn-fill__bg"></span>
        <span class="btn-fill__label">Start a project</span>
      </a>
    </nav>
  </div>


  <!-- ═══════════════════════════════════════ HERO -->
  <section class="min-h-[100dvh] bg-parchment flex flex-col relative overflow-hidden px-6 md:px-12 lg:px-24">

    <!-- Hero video — masked visual, right side on desktop -->
    <div class="mss-hero-video-wrap" aria-hidden="true">
      <video id="hero-video" autoplay muted playsinline
        src="/assets/3d-mark-animation.mp4">
      </video>
    </div>

    <!-- Content -->
    <div class="flex-1 flex flex-col justify-center pt-24 md:pt-28 pb-10 max-w-[1400px] w-full mx-auto relative z-10">

      <!-- Label -->
      <div class="line-clip mb-8 md:mb-10">
        <span class="line-clip__inner slabel" style="transition-delay:0.1s;">Digital Studio · London</span>
      </div>

      <!-- Headline -->
      <h1 id="hero-headline" class="font-display font-normal text-near-black mb-6 md:mb-8" style="font-size:clamp(3rem,8vw,7.5rem);line-height:1.0;letter-spacing:-0.025em;">
        <span class="line-clip" style="display:block;">
          <span class="line-clip__inner" style="transition-delay:0.22s;">Launched is not</span>
        </span>
        <span class="line-clip text-terracotta" style="display:block;margin-top:0.08em;">
          <span class="line-clip__inner" style="transition-delay:0.38s;color:var(--terracotta);">the same as alive.</span>
        </span>
      </h1>

      <!-- Subhead -->
      <div class="line-clip mb-8 md:mb-10">
        <p class="line-clip__inner font-sans font-normal text-near-black" style="transition-delay:0.56s;font-size:clamp(1.125rem,2vw,1.375rem);line-height:1.4;max-width:36ch;">
          Going live is the easy part. The job is every week after.
        </p>
      </div>

      <!-- Body -->
      <div>
        <div class="line-clip mb-8">
          <p class="line-clip__inner font-sans font-light muted-text" style="transition-delay:0.72s;font-size:1.0625rem;line-height:1.72;max-width:52ch;">
            Most businesses know exactly what a strong presence looks like. A website that reflects the quality of the work. Social accounts that stay alive past the first month. Words that actually sound like you.
          </p>
        </div>
        <div class="line-clip mb-8">
          <p class="line-clip__inner font-sans font-light muted-text" style="transition-delay:0.84s;font-size:1.0625rem;line-height:1.72;max-width:52ch;">
            What they don't have is the team to keep all of that running — and hiring one costs more than the problem.
          </p>
        </div>
        <div class="line-clip mb-8">
          <p class="line-clip__inner font-sans font-light muted-text" style="transition-delay:0.96s;font-size:1.0625rem;line-height:1.72;max-width:52ch;">
            Main Stage Studio builds your presence, then runs it. Brand, website, content: made in one system, reviewed by you in one place, kept moving week after week.
          </p>
        </div>
        <div class="line-clip">
          <div class="line-clip__inner flex items-center gap-6 flex-wrap" style="transition-delay:1.1s;">
            <a href="#contact" class="btn-fill">
              <span class="btn-fill__bg"></span>
              <span class="btn-fill__label">Start a project</span>
            </a>
            <a href="#how-it-works" class="btn-ghost">
              See how it works
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                <path d="M1 6.5h11M7.5 1.5l5 5-5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom rule -->
    <div class="pb-8 max-w-[1400px] w-full mx-auto flex items-center gap-6 relative z-10">
      <hr class="flex-1">
      <span class="font-sans text-near-black shrink-0" style="font-size:0.5625rem;letter-spacing:0.22em;text-transform:uppercase;opacity:0.28;">Scroll</span>
    </div>
  </section>


  <!-- ═══════════════════════════════════════ MARQUEE -->
  <div class="bg-near-black overflow-hidden py-[13px]" data-nav-dark="true" aria-hidden="true">
    <div class="marquee-track flex whitespace-nowrap">
      <span class="flex items-center shrink-0">
        <span class="font-sans text-terracotta uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;">Built Once</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-parchment uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;opacity:0.3;">Run Every Week</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-parchment uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;opacity:0.3;">Reviewed By You</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-parchment uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;opacity:0.3;">Never Left Quiet</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-terracotta uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;">Built Once</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-parchment uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;opacity:0.3;">Run Every Week</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-parchment uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;opacity:0.3;">Reviewed By You</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
        <span class="font-sans text-parchment uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;opacity:0.3;">Never Left Quiet</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
      </span>
      <span class="flex items-center shrink-0" aria-hidden="true">
        <span class="font-sans text-terracotta uppercase px-10" style="font-size:0.5625rem;letter-spacing:0.24em;">Built Once</span>
        <span class="text-blush text-xs" style="opacity:0.25;">·</span>
