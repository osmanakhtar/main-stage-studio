  <script>
    // ── SCROLL PROGRESS ───────────────────────────────────────────────────
    const progressBar = document.getElementById('scroll-progress');
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progressBar.style.width = (window.scrollY / max * 100) + '%';
    };
    window.addEventListener('scroll', updateProgress, { passive: true });

    // ── NAV ───────────────────────────────────────────────────────────────
    const nav = document.getElementById('nav');
    const navCta = document.getElementById('nav-cta');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        nav.style.pointerEvents = 'none';
        const el = document.elementFromPoint(
          window.innerWidth / 2,
          nav.getBoundingClientRect().bottom + 2
        );
        nav.style.pointerEvents = '';
        const isDark = el && el.closest('[data-nav-dark]');
        nav.classList.toggle('scrolled-dark', !!isDark);
        nav.classList.toggle('scrolled-light', !isDark);
        if (navCta) navCta.classList.toggle('light', !!isDark);
      } else {
        nav.classList.remove('scrolled-light', 'scrolled-dark');
        if (navCta) navCta.classList.remove('light');
      }
    }, { passive: true });

    // ── HERO LINE REVEAL ──────────────────────────────────────────────────
    // Now handled entirely in CSS (@keyframes lineRise). No JS involved.

    // ── HERO VIDEO ────────────────────────────────────────────────────────
    const heroVideo = document.getElementById('hero-video');
    if (heroVideo) {
      heroVideo.playbackRate = 0.75;
      const showVideo = () => { heroVideo.style.opacity = '1'; };
      heroVideo.addEventListener('canplay', showVideo, { once: true });
      heroVideo.addEventListener('play', showVideo, { once: true });
      heroVideo.addEventListener('ended', () => {
        heroVideo.pause();
      }, { once: true });
      heroVideo.play().catch(() => {});
    }

    // ── MOBILE MENU ───────────────────────────────────────────────────────
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const bar1 = document.getElementById('bar1');
    const bar2 = document.getElementById('bar2');
    const bar3 = document.getElementById('bar3');
    let menuOpen = false;

    const setMenu = open => {
      menuOpen = open;
      mobileMenu.style.transform = open ? 'translateX(0)' : 'translateX(100%)';
      mobileMenu.setAttribute('aria-hidden', String(!open));
      // inert keeps the four off-screen links out of the tab order while closed.
      if (open) mobileMenu.removeAttribute('inert');
      else      mobileMenu.setAttribute('inert', '');
      menuToggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      bar1.style.transform = open ? 'translateY(6px) rotate(45deg)'   : '';
      bar2.style.opacity   = open ? '0' : '1';
      bar3.style.transform = open ? 'translateY(-6px) rotate(-45deg)' : '';
    };

    menuToggle.addEventListener('click', () => setMenu(!menuOpen));

    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => { if (menuOpen) setMenu(false); });
    });

    // Escape closes the menu and returns focus to the toggle.
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menuOpen) { setMenu(false); menuToggle.focus(); }
    });

    // Widening past the breakpoint with the menu open left a full-screen
    // parchment panel stranded over the desktop layout, with no visible
    // toggle left to close it.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', e => {
      if (e.matches && menuOpen) setMenu(false);
    });

    // ── ACTIVE SECTION IN NAV ─────────────────────────────────────────────
    // Same IntersectionObserver approach as the reveals below. The rootMargin
    // collapses the viewport to a thin band across the middle, so exactly one
    // section qualifies at a time: whichever is crossing the centre line.
    const navLinks = [...document.querySelectorAll('#nav .nav-link[href^="#"]')];
    const linkFor  = new Map();
    navLinks.forEach(link => {
      const section = document.querySelector(link.getAttribute('href'));
      if (section) linkFor.set(section, link);
    });

    const setActive = link => {
      navLinks.forEach(l => l.classList.toggle('active', l === link));
    };

    const sectionObserver = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) setActive(linkFor.get(e.target));
      });
    }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

    linkFor.forEach((_link, section) => sectionObserver.observe(section));

    // Above the first tracked section (the hero) nothing should be marked.
    const firstSection = [...linkFor.keys()][0];
    if (firstSection) {
      new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (e.isIntersecting && e.boundingClientRect.top > 0) setActive(null);
        });
      }, { threshold: 0 }).observe(firstSection);
    }

    // ── SCROLL REVEAL ─────────────────────────────────────────────────────
    const observer = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in-view');
          observer.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // ── SPOTLIGHT BORDER ──────────────────────────────────────────────────
    document.querySelectorAll('.spotlight-card').forEach(card => {
      card.addEventListener('mousemove', e => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top)  + 'px');
      });
    });

    // ── GAP ANCHOR PARALLAX ───────────────────────────────────────────────
    // A single quiet drift as the image crosses the viewport, not a loop or a
    // hover state, the section's only motion, in keeping with "punctuation,
    // not decoration". Clamped range keeps it inside the image's own overflow
    // wrapper so nothing clips or reveals the parchment behind it.
    [['gap-anchor', 'gap-anchor-img'], ['hiw-anchor', 'hiw-anchor-img']].forEach(([wrapId, imgId]) => {
      const wrap = document.getElementById(wrapId);
      const img  = document.getElementById(imgId);
      if (!wrap || !img) return;
      // The drift has to stay inside the overhang the scale creates, or the
      // parchment behind shows at the edges. A fixed 12px was safe on the
      // 668px portrait anchor and is not on the 208px Gap band, so the range
      // is derived from each element's own height: scale 1.08 gives
      // height * 0.04 of overhang per side, and 0.8 of that is the budget.
      const SCALE = 1.08;
      const update = () => {
        const r = wrap.getBoundingClientRect();
        const progress = 1 - Math.min(1, Math.max(0, r.top / window.innerHeight));
        const range = r.height * (SCALE - 1) * 0.8;
        const offset = (progress - 0.5) * range;
        img.style.transform = `translateY(${offset}px) scale(${SCALE})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      update();
    });

    // ── SYSTEM PROGRESS LINE ──────────────────────────────────────────────
    const systemSection = document.getElementById('how-it-works');
    const systemLine    = document.getElementById('system-line');
    const updateLine = () => {
      if (!systemSection) return;
      const r = systemSection.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, -r.top / (r.height - window.innerHeight)));
      systemLine.style.transform = `scaleY(${progress})`;
    };
    window.addEventListener('scroll', updateLine, { passive: true });

    // ── DIRECTIONAL FILL BUTTONS ──────────────────────────────────────────
    document.querySelectorAll('.btn-fill').forEach(btn => {
      btn.addEventListener('mouseenter', e => {
        const r = btn.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        btn.classList.remove('from-right', 'from-top', 'from-bottom');
        if      (x > r.width  * 0.7) btn.classList.add('from-right');
        else if (y < r.height * 0.3) btn.classList.add('from-top');
        else if (y > r.height * 0.7) btn.classList.add('from-bottom');
      });
    });

    // ── FORM ──────────────────────────────────────────────────────────────
    const form      = document.getElementById('contact-form');
    const successEl = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn');
    const submitLbl = submitBtn.querySelector('.btn-fill__label');

    const validators = [
      { id:'need',    err:null,          ok: v => v.trim().length > 0 },
      { id:'name',    err:'err-name',    ok: v => v.trim().length > 0 },
      { id:'email',   err:'err-email',   ok: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
      { id:'project', err:'err-project', ok: v => v.trim().length > 0 },
    ];

    validators.forEach(({ id, err }) => {
      if (!err) return;
      document.getElementById(id).addEventListener('input', () => {
        document.getElementById(err).classList.add('hidden');
        document.getElementById(id).removeAttribute('aria-invalid');
      });
    });

    form.addEventListener('submit', async e => {
      e.preventDefault();
      let valid = true;
      let firstInvalid = null;
      validators.forEach(({ id, err, ok }) => {
        const el   = document.getElementById(id);
        const pass = ok(el.value);
        if (err) document.getElementById(err).classList.toggle('hidden', pass);
        if (pass) el.removeAttribute('aria-invalid');
        else      el.setAttribute('aria-invalid', 'true');
        if (!pass) { valid = false; firstInvalid = firstInvalid || el; }
      });
      // Send focus to the first problem rather than leaving the user to hunt.
      if (firstInvalid) firstInvalid.focus();
      if (!valid) return;

      submitLbl.textContent = 'Sending…';
      submitBtn.disabled = true;

      try {
        const response = await fetch('https://formspree.io/f/mnjyqooa', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: new FormData(form),
        });

        if (response.ok) {
          form.querySelectorAll('.flex.flex-col').forEach(el => {
            el.style.opacity = '0.25';
            el.style.pointerEvents = 'none';
          });
          form.querySelector('.flex.items-center.gap-6').style.opacity = '0.25';
          successEl.classList.remove('hidden');
          successEl.classList.add('flex');
        } else {
          submitLbl.textContent = 'Send it over';
          submitBtn.disabled = false;
          alert('Something went wrong. Please try emailing us directly at hello@mainstagestudio.co.uk');
        }
      } catch {
        submitLbl.textContent = 'Send it over';
        submitBtn.disabled = false;
        alert('Something went wrong. Please try emailing us directly at hello@mainstagestudio.co.uk');
      }
    });

    // Tooling clips: click-to-play, then native controls so the clip can be
    // scrubbed. Nothing downloads until the first press (preload="none").
    document.querySelectorAll('.clip-frame').forEach(frame => {
      const video = frame.querySelector('video');
      const button = frame.querySelector('.clip-play');
      if (!video || !button) return;

      button.addEventListener('click', () => {
        frame.classList.add('is-playing');
        video.controls = true;
        video.play();
        video.focus();
      });

      // Pause on scroll-out so two clips never run at once unseen.
      new IntersectionObserver(entries => {
        entries.forEach(e => {
          if (!e.isIntersecting && !video.paused) video.pause();
        });
      }, { threshold: 0.25 }).observe(frame);
    });
  </script>

</body>
</html>
